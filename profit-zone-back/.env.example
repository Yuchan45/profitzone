# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=8080

# Orígenes permitidos por CORS (separados por coma). El front de Vite corre en 5173.
CORS_ORIGINS=http://localhost:5173

# SQL Server (docker-compose.yml en la raíz: npm run db:up)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ProfitZone
# Solo desarrollo: usuario administrador del contenedor.
DB_USER=sa
# Política de SQL Server: 8+ caracteres, 3 de 4 tipos (mayúscula, minúscula, número, símbolo). Sin "$".
DB_PASSWORD=Cambiar-por-una-clave-local-1
# true para ver en consola el SQL que ejecuta Sequelize
DB_LOGGING=false

# Google Places API (opcional en desarrollo; sin clave usa simulación realista)
GOOGLE_PLACES_API_KEY=tu-api-key-de-google-places

# BestTime API (opcional para popular times / afluencia)
BESTTIME_API_KEY=

# Autenticación (JWT de acceso + refresh token en cookie httpOnly)
# Secreto para firmar los JWT: 32+ caracteres aleatorios. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Vida del JWT de acceso (número + s/m/h/d)
JWT_ACCESS_TTL=15m
# Vida del refresh token en días (1-90)
REFRESH_TOKEN_TTL_DAYS=7
# Cookie con flag Secure (solo HTTPS). Sin definir: true en producción, false en desarrollo
# COOKIE_SECURE=false
