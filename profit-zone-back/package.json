{
  "name": "profit-zone-back",
  "version": "1.0.0",
  "description": "Backend del proyecto ProfitZone (Seminario UADE)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "smoke": "node scripts/smoke.js",
    "db:up": "docker compose -f ../docker-compose.yml --env-file .env up -d --wait",
    "db:down": "docker compose -f ../docker-compose.yml --env-file .env down",
    "db:logs": "docker compose -f ../docker-compose.yml --env-file .env logs -f sqlserver",
    "db:migrate": "node scripts/migrate.js up",
    "db:migrate:undo": "node scripts/migrate.js down",
    "db:migrate:status": "node scripts/migrate.js status",
    "db:seed:catalog": "node scripts/seed-catalog.js",
    "db:seed:catalog:verify": "node scripts/verify-catalog-seed.js",
    "db:seed:census": "node scripts/seed-census.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "sequelize": "^6.37.8",
    "tedious": "^20.0.0",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
